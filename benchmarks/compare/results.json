  "method": {
    "input": "48 kHz 16-bit noisy file + 100 ms of silence, same for every system",
    "resampling": "ffmpeg -af aresample=resampler=soxr -ar 16000 -c:a pcm_f32le (clean reference, 16 kHz system inputs, 48 kHz system outputs)",
    "alignment": "constant delay per system: median cross-correlation peak against the clean reference on 24 evenly spaced files (search +/-250 ms); outputs shifted by it and cut to the clean length",
    "metrics": {
      "pesq_wb": "ITU-T P.862.2 wide-band, pesq 0.0.4 (Python wrapper of the ITU reference C code)",
      "stoi/estoi": "pystoi 0.4.1",
      "si_sdr": "numpy, zero-mean, scale-invariant (Le Roux et al. 2019)",
      "dnsmos": "DNSMOS P.835 sig_bak_ovr.onnx from microsoft/DNS-Challenge @591184a (MIT), dnsmos_local.py logic, personalized=False, onnxruntime 1.31.1",
      "summary": "mean over all files; std; ci95 = 1.96 * std / sqrt(n)"
    }
  },
