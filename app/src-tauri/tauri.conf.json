{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hush AI",
  "version": "../package.json",
  "identifier": "ai.hush.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hush AI",
        "url": "index.html",
        "width": 940,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "widget",
        "title": "Hush AI",
        "url": "index.html#widget",
        "width": 340,
        "height": 476,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Noise cancellation for every app",
    "longDescription": "Hush AI removes background noise from your microphone in real time, on your own computer, and gives every app a clean Hush AI Microphone.",
    "copyright": "Hush AI contributors",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "pulseaudio-utils"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1Q0NBMjQ0QjcxQjg2NzkKUldSNWhodTNSS0xNbGJLYSs3ZDVZMEJ1THFYT09kQWJiM2psdUh0Uzl1WjZJcGdEbGpVNzhXdjMK",
      "endpoints": [
        "https://github.com/alshell7/hush-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
